{
  "name": "@chimix/agentscan",
  "version": "1.2.1",
  "description": "Offline linter for Claude Code, Command Code, Grok Build, portable Agent Skills, AGENTS.md, and MCP/hooks/rules for VS Code, Cursor, Codex, Gemini, OpenCode, and Continue",
  "type": "module",
  "bin": {
    "agentscan": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skills",
    "claude-code",
    "command-code",
    "grok",
    "mcp",
    "hooks",
    "lint",
    "config",
    "cli",
    "bun"
  ],
  "homepage": "https://github.com/SimaAlexandru99/agentscan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimaAlexandru99/agentscan.git"
  },
  "bugs": {
    "url": "https://github.com/SimaAlexandru99/agentscan/issues"
  },
  "author": "Sima Alexandru <sima.alex33@gmail.com>",
  "scripts": {
    "agentscan": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run src/cli.ts check",
    "spec:check": "bun run scripts/spec-drift.ts",
    "build": "bun build src/cli.ts --target=node --outfile dist/cli.js --banner '#!/usr/bin/env node'",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=20.11.0",
    "bun": ">=1.4.0"
  },
  "license": "MIT",
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}
